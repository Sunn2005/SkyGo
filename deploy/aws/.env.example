# Copy to .env on the server (cp .env.example .env) and fill in the values.
# Never commit the real .env file.

# sslip.io name for the server's static IP: replace dots with dashes.
# Example: IP 13.229.10.5 -> 13-229-10-5.sslip.io
SITE_HOST=

# Strong random passwords, e.g. generated with: openssl rand -base64 24
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# Base64 of 32 random bytes: openssl rand -base64 32
# Keep these stable forever; changing or losing them makes stored data unreadable.
SKYGO_REVIEW_ENCRYPTION_KEY=
SKYGO_BOOKING_DOCUMENT_ENCRYPTION_KEY=

AUTH_SESSION_TTL=24h

# AI assistant. Leave false unless you set GEMINI_API_KEY.
SKYGO_AI_ENABLED=false
# Model chat Gemini và timeout mỗi lần gọi (tối đa 2m). Bỏ trống để dùng mặc định của backend.
SKYGO_AI_CHAT_MODEL=gemini-3.1-flash-lite
SKYGO_AI_TIMEOUT=30s
GEMINI_API_KEY=

# PayOS (optional until you demo payments)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=skygo://payment/success
PAYOS_CANCEL_URL=skygo://payment/cancel
