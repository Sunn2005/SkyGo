DB_URL=jdbc:mariadb://localhost:3306/skygo?createDatabaseIfNotExist=true
DB_USERNAME=skygo_app
DB_PASSWORD=CHANGE_ME
AUTH_SESSION_TTL=24h
SKYGO_REVIEW_ENCRYPTION_KEY=
SKYGO_REVIEW_KEY_ID=v1
SKYGO_BOOKING_DOCUMENT_ENCRYPTION_KEY=
SKYGO_BOOKING_DOCUMENT_KEY_ID=v1
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# AI is opt-in. These variables can also be set in the IDE or OS environment.
SKYGO_AI_ENABLED=false
GEMINI_API_KEY=
SKYGO_AI_CHAT_MODEL=gemini-3.1-flash-lite
SKYGO_AI_EMBEDDING_MODEL=gemini-embedding-001
SKYGO_AI_EMBEDDING_DIMENSIONS=768
SKYGO_AI_TIMEOUT=30s
SKYGO_AI_TOP_K=4
SKYGO_AI_SIMILARITY_THRESHOLD=0.65
SKYGO_AI_MAX_OUTPUT_TOKENS=2048
SKYGO_AI_CHAT_MAX_TOOL_ROUNDS=2
SKYGO_AI_CHAT_MAX_TOOL_CALLS=4
SKYGO_AI_CHAT_MODEL_CALLS_PER_MINUTE=4
# Airport-only semantic fallback; defaults need validation against real query scores.
SKYGO_AI_AIRPORT_TOP_K=5
SKYGO_AI_AIRPORT_MIN_SIMILARITY=0.65
SKYGO_AI_AIRPORT_AUTO_SELECT_SIMILARITY=0.85
SKYGO_AI_AIRPORT_MIN_SCORE_GAP=0.10
# Enable to index MariaDB at startup and then reconcile every five minutes.
SKYGO_AI_INDEX_ENABLED=false
SKYGO_AI_INDEX_FIXED_DELAY=5m
SKYGO_AI_INDEX_BATCH_SIZE=8
SKYGO_AI_INDEX_BATCH_DELAY=10s
SKYGO_AI_INDEX_FLIGHT_DAYS=30
SKYGO_AI_INDEX_BOOKING_DAYS=15
SKYGO_AI_INDEX_MAX_DOCUMENTS=50000
